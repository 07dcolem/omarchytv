<?xml version="1.0" encoding="utf-8"?>
<!-- Omarchy workspaces are plain numbers; the focused one is bright, with a thin accent underline. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <item android:top="20dp" android:left="7dp" android:right="7dp">
                <shape android:shape="rectangle"><solid android:color="@color/tn_blue" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#00000000" /></shape>
    </item>
</selector>
