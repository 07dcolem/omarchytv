#!/usr/bin/env python3
"""omarchy-tv: Omarchy-style front-end for OmarchyTV (Android TV & LG webOS), built on omarchy-link.

  omarchy-tv [menu]                     Omarchy menu (omarchy-menu-select; Walker on older Omarchy; gum / numbered list over SSH)
  omarchy-tv status | pair | remote KEY | cast [TARGET]
  omarchy-tv screen start [--audio] | screen stop     live "Schermo PC" (opt-in, H.264 MPEG-TS over the link)
  omarchy-tv themes list | push [NAME|--all] | select NAME [BG] | delete NAME
  omarchy-tv icons list | push [PACKAGE|--all] | delete PACKAGE   your own banners, ~/.config/omarchy-tv/banners/<package>.png
  omarchy-tv update <APK|IPK> [--tv IP:5555|DEVICE] [--yes] [--dry-run]
                                        Android (.apk): adb install -r, cert + versionCode checked
                                        LG webOS (.ipk): appinfo.json checked + ares-install
  omarchy-tv webos-serve [--port 8765] [--bind 0.0.0.0]
                                        LAN HTTP server for LG webOS TVs (/v1/status, /v1/themes, /v1/wallpaper)
  omarchy-tv stats                      show the stats pushed every 5 s while the TV home is visible
  omarchy-tv mcp [--stdio|--http] [--port 8990] [--tunnel]   MCP server for Grok Bot / Claude / Hermes
"""
import os, sys
HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(HERE, "..", "lib"))
for cand in (os.environ.get("OMARCHY_LINK_LIB"), os.path.expanduser("~/.local/share/omarchy-link/lib"),
             os.path.join(HERE, "..", "..", "omarchy-link", "lib"),
             os.path.join(HERE, "..", "..", "..", "omarchy-link", "lib")):
    if cand and os.path.isdir(os.path.join(cand, "omarchy_link")):
        sys.path.insert(1, cand)
        exe = os.path.join(cand, "..", "bin", "omarchy-link")
        if os.path.isfile(exe):
            os.environ.setdefault("OMARCHY_LINK_BIN", os.path.realpath(exe))
        break
from omarchy_tv import ui, themes, update, banners, webos, mcp_server  # noqa: E402
from omarchy_tv.i18n import t  # noqa: E402

MENU = [("󰍹  " + t("menu.status"), "status"), ("󰌘  " + t("menu.pair"), "pair"), ("󰖟  " + t("menu.webos"), "webos-serve"),
        ("󰸌  " + t("menu.themes"), "themes"), ("󰍺  " + t("menu.screen"), "screen"), ("󰚰  " + t("menu.update"), "update"),
        ("󰄘  " + t("menu.cast"), "cast"), ("󰑔  " + t("menu.remote"), "remote")]


def client():
    from omarchy_link import config, client as link
    p = config.Pairing.load()
    if not p.paired:
        ui.say(t("not_paired"))
        raise SystemExit(3)
    return link.Client(p.tv, p.pc_id, not config.load_config().get("allowOtherSubnets"))


def cmd_themes(args):
    sub = args[0] if args else None
    if sub is None:
        subs = {t("themes.push"): "push", t("themes.list"): "list", t("themes.select"): "select", t("themes.delete"): "delete"}
        sub = subs.get(ui.choose(t("themes.prompt"), list(subs)) or "")
        if not sub:
            return 0
    c = client()
    if sub == "list":
        r = themes.list_tv(c)
        for th in r.get("themes", []):
            ui.say(t("themes.row", name=th['name'], n=len(th['backgrounds']), mb=th['bytes'] / 1e6))
        ui.say(t("themes.used", used=r.get('used', 0) / 1048576, cap=r.get('cap', themes.CAP) / 1048576))
        return 0
    if sub == "push":
        found = themes.user_themes()
        if "--all" in args:
            pick = found
        else:
            name = args[1] if len(args) > 1 else ui.choose(t("themes.push_prompt"), [th.name for th in found])
            pick = [th for th in found if th.name == name]
        if not pick:
            ui.say(t("themes.none")); return 1
        for th in pick:
            r = themes.push(c, th)
            ui.say(t("themes.pushed", name=r['name'], n=len(r['backgrounds']), mb=r['bytes'] / 1e6))
            ui.notify(t("themes.sent", name=r['name']))
        return 0
    if sub == "select":
        names = [th["name"] for th in themes.list_tv(c).get("themes", [])]
        name = args[1] if len(args) > 1 else ui.choose(t("themes.select_prompt"), names)
        if not name:
            return 0
        themes.select(c, name, int(args[2]) if len(args) > 2 else 0)
        ui.notify(t("themes.selected", name=name))
        return 0
    if sub == "delete":
        name = args[1] if len(args) > 1 else ui.choose(t("themes.delete_prompt"), [th["name"] for th in themes.list_tv(c).get("themes", [])])
        if name and ("--yes" in args or ui.confirm(t("themes.delete_confirm", name=name))):
            themes.delete(c, name)
            ui.say(t("themes.deleted", name=name))
        return 0
    ui.say(__doc__); return 2


def cmd_icons(args):
    sub = args[0] if args else None
    if sub is None:
        subs = {t("icons.push"): "push", t("icons.list"): "list", t("icons.delete"): "delete"}
        sub = subs.get(ui.choose(t("icons.prompt"), list(subs)) or "")
        if not sub:
            return 0
    if sub not in ("list", "push", "delete"):
        ui.say(__doc__); return 2
    c = client()
    try:
        tv = banners.list_tv(c)
    except Exception as e:
        if "404" in str(e) or "not_found" in str(e):
            ui.say(t("icons.unsupported")); return 1
        raise
    if sub == "list":
        for pkg in tv.get("banners", []):
            ui.say(t("icons.row", pkg=pkg))
        return 0
    if sub == "push":
        found = banners.local()
        if len(args) > 1 and args[1] != "--all":
            found = [f for f in found if f[0] == args[1]]
        if not found:
            ui.say(t("icons.none")); return 1
        for pkg, path in found:
            banners.push(c, pkg, path)
            ui.say(t("icons.pushed", pkg=pkg, kb=path.stat().st_size / 1024))
        ui.notify(t("icons.sent", n=len(found)))
        return 0
    pkg = args[1] if len(args) > 1 else ui.choose(t("icons.delete_prompt"), tv.get("banners", []))
    if pkg:
        banners.delete(c, pkg)
        ui.say(t("icons.deleted", pkg=pkg))
    return 0


def cmd_screen(args):
    """Live screen: delegates to omarchy-link cast --screen (gpu-screen-recorder / wf-recorder, hw encode if any)."""
    action = args[0] if args else (ui.choose(t("screen.prompt"), ["start", "start --audio", "stop"]) or "")
    if action.startswith("start"):
        env = dict(os.environ)
        if "--audio" in args or "--audio" in action:
            env["OMARCHY_LINK_SCREEN_AUDIO"] = "1"
        return ui.run(["omarchy-link", "cast", "--screen"], env=env)
    if action == "stop":
        return ui.run(["omarchy-link", "cast", "--stop"])
    return 0


def cmd_webos_serve(args):
    port = int(args[args.index("--port") + 1]) if "--port" in args else 8765
    bind = args[args.index("--bind") + 1] if "--bind" in args else "0.0.0.0"
    once = "--once" in args
    return webos.serve(bind=bind, port=port, once=once)


def main(argv):
    args = argv[1:]
    cmd = args[0] if args else "menu"
    rest = args[1:]
    if cmd == "menu":
        pick = ui.choose("OmarchyTV…", [m[0] for m in MENU])
        cmd = dict(MENU).get(pick or "", "")
        if not cmd:
            return 0
    if cmd in ("pair", "status", "cast"):
        return ui.run(["omarchy-link", cmd] + rest)
    if cmd == "remote":
        return ui.run(["omarchy-link", "key", rest[0] if rest else (ui.choose(t("remote.prompt"), ["home", "back", "up", "down", "left", "right", "ok", "play_pause"]) or "home")])
    if cmd == "themes":
        return cmd_themes(rest)
    if cmd == "screen":
        return cmd_screen(rest)
    if cmd == "icons":
        return cmd_icons(rest)
    if cmd in ("webos-serve", "webos"):
        return cmd_webos_serve(rest)
    if cmd == "mcp":
        port = int(rest[rest.index("--port") + 1]) if "--port" in rest else 8990
        if "--http" in rest or "--tunnel" in rest:
            return mcp_server.serve_http(client, port=port, tunnel="--tunnel" in rest)
        return mcp_server.serve_stdio(client)
    if cmd == "stats":
        from omarchy_link import stats, config
        ui.say(str(stats.payload(config.load_config())))
        return 0
    if cmd == "update":
        apk = rest[0] if rest and not rest[0].startswith("-") else ui.ask(t("update.apk_prompt"))
        tv = rest[rest.index("--tv") + 1] if "--tv" in rest else (rest[rest.index("--device") + 1] if "--device" in rest else None)
        return update.update(apk, tv, dry_run="--dry-run" in rest, yes="--yes" in rest)
    ui.say(__doc__)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except Exception as e:  # LinkError, ValueError, OSError: one Omarchy-style line + notification
        ui.say(f"✗ {e}")
        ui.notify(t("error", e=e))
        sys.exit(1)
