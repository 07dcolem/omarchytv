{
  "themeSync": true,
  "wallpaperSync": true,
  "pcPane": true,
  "aiCredits": true,
  "aiSourcesFromTv": true,
  "aiRefreshMinutes": 15,
  "assistant": true,
  "allowOtherSubnets": false,
  "actions": {
    "lock": {
      "label": "Lock PC",
